<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="QUT.CAB302.fortunecookie.Controller.HomepageController"
            style="-fx-background-color: #FFF9F2; -fx-font-family: 'Aptos';">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 10 30; -fx-background-color:rgb(255, 188, 106);">
            <Label text="Quote Me"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Profile"
                   fx:id="toSettings"
                   onMouseClicked="#goToSettings"
                   style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-cursor: hand;"/>
            <Label text="Log Out"
                   fx:id="toLogin"
                   onMouseClicked="#goToLogin"
                   style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- Center: Cookie image + buttons -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30 0 0 0;">
            <ImageView fx:id="cookieImage"
                       fitWidth="200"
                       fitHeight="200"
                       preserveRatio="true"
                       pickOnBounds="true"
                       onMouseClicked="#onCookieClick"
                       style="-fx-cursor: hand;">
                <Image url="@Prediction.png"/>
            </ImageView>
            <Label text="Double Tap"
                   style="-fx-font-size: 16px; -fx-text-fill: #333333;"/>
            <HBox alignment="CENTER" spacing="20">
                <Button text="Study Mode"
                        fx:id="toStudyMode"
                        prefWidth="150"
                        onMouseClicked="#goToStudyMode"
                        style="
                            -fx-background-color: #FFDAB9;
                            -fx-text-fill: #333333;
                            -fx-font-size: 16px;
                            -fx-background-radius: 30;
                            -fx-padding: 12 28;
                            -fx-cursor: hand;"/>
                <Button text="Study Vault"
                        fx:id="toStudyVault"
                        prefWidth="140"
                        onMouseClicked="#goToStudyVault"
                        style="
                            -fx-background-color: #FFDAB9;
                            -fx-text-fill: #333333;
                            -fx-font-size: 16px;
                            -fx-background-radius: 30;
                            -fx-padding: 12 28;
                            -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </center>

    <!-- Bottom: Study Boost Card -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 20 40;">
            <StackPane style="
                -fx-background-color: white;
                -fx-border-color: #D3E5F0;
                -fx-border-radius: 8;
                -fx-background-radius: 8;
                -fx-padding: 20;
                -fx-pref-width: 260;">
                <VBox spacing="12">
                    <Label text="Today's Study Boost"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="streakLabel"
                           text="Study streak: 🔥 0"
                           style="-fx-font-size: 14px;"/>
                    <Label text="Quote:"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="quoteLabel"
                           text="Stay focused and keep going!"
                           wrapText="true"
                           maxWidth="220"
                           style="-fx-font-size: 14px; -fx-font-style: italic;"/>
                </VBox>
            </StackPane>
        </HBox>
    </bottom>

</BorderPane>
