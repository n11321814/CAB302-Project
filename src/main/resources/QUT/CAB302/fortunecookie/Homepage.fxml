<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #FFF9F2; -fx-font-family: 'Aptos';" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="QUT.CAB302.fortunecookie.Controller.HomepageController">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10 30; -fx-background-color:rgb(255, 188, 106);">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Quote Me" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="toSettings" onMouseClicked="#goToSettings" style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-cursor: hand;" text="Profile" />
            <Label fx:id="toLogin" onMouseClicked="#goToLogin" style="-fx-font-size: 16px; -fx-text-fill: #333333; -fx-cursor: hand;" text="Log Out" />
        </HBox>
    </top>

    <!-- Center: Cookie image + buttons -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30 0 0 0;">
            <ImageView fx:id="cookieImage" fitHeight="200" fitWidth="200" onMouseClicked="#onCookieClick" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                <Image url="@Prediction.png" />
            </ImageView>

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="toStudyMode" onMouseClicked="#goToStudyMode" prefWidth="150" style="                             -fx-background-color: #FFDAB9;                             -fx-text-fill: #333333;                             -fx-font-size: 16px;                             -fx-background-radius: 30;                             -fx-padding: 12 28;                             -fx-cursor: hand;" text="Study Mode" />
                <Button fx:id="toStudyVault" onMouseClicked="#goToStudyVault" prefWidth="140" style="                             -fx-background-color: #FFDAB9;                             -fx-text-fill: #333333;                             -fx-font-size: 16px;                             -fx-background-radius: 30;                             -fx-padding: 12 28;                             -fx-cursor: hand;" text="Study Vault" />
            </HBox>
        </VBox>
    </center>

    <!-- Bottom: Study Boost Card -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 20 40;">
            <StackPane alignment="TOP_CENTER" style="                 -fx-background-color: white;                 -fx-border-color: #D3E5F0;                 -fx-border-radius: 8;                 -fx-background-radius: 8;                 -fx-padding: 20;                 -fx-pref-width: 260;">
                <VBox spacing="12">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Today's Study Boost" />
                    <Label fx:id="streakLabel" style="-fx-font-size: 14px;" text="Study streak: 🔥 1" />
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Quote of the Day" />
                    <Label fx:id="quoteLabel" maxWidth="220" style="-fx-font-size: 14px; -fx-font-style: italic;" text="The best way to predict the future is to create it" wrapText="true" />
                </VBox>
            </StackPane>
        </HBox>
    </bottom>

</BorderPane>
