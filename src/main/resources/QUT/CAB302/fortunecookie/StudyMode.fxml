<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="QUT.CAB302.fortunecookie.Controller.StudyModeController"
            style="-fx-background-color: #FFF9F2;">

    <!-- Top bar: Study Mode header with Back and LOG OUT -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #FFE4C4; -fx-padding: 10 20;">
            <!-- Changed to fx:id=backToHome to match controller and onAction calls goBack() -->
            <Button fx:id="backToHome"
                    text="← Back"
                    onAction="#goBack"
                    style="-fx-font-size: 14px; -fx-background-color: transparent; -fx-text-fill: #5A3E1B; -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="LOG OUT"
                   fx:id="toLogin"
                   onMouseClicked="#goToLogin"
                   style="-fx-font-size: 14px; -fx-text-fill: #5A3E1B;"/>
        </HBox>
    </top>

    <!-- Center: responsive two-column layout -->
    <center>
        <GridPane hgap="20" vgap="20" style="-fx-padding:20;">
            <columnConstraints>
                <ColumnConstraints percentWidth="70" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="30" hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Left: input form and timer -->
            <VBox GridPane.columnIndex="0" spacing="15" alignment="TOP_CENTER">
                <Label text="Enter Study Details"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <TextField fx:id="subjectTextField"
                           promptText="Enter Subject"
                           style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5;"/>
                <TextField fx:id="durationTextField"
                           promptText="Enter Duration (in minutes)"
                           style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Select Your Mood:" style="-fx-font-size: 14px;"/>
                    <ComboBox fx:id="moodComboBox"
                              promptText="Choose mood"
                              style="-fx-font-size: 14px;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Happy😁"/>
                                <String fx:value="Motivated😎"/>
                                <String fx:value="Tired😩"/>
                                <String fx:value="Stressed😐"/>
                                <String fx:value="Relaxed😊"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </HBox>

                <Button text="Ask AI"
                        onMouseClicked="#handleAskAI"
                        style="-fx-font-size: 14px; -fx-padding: 8 16;"/>
                <TextArea fx:id="aiResponse"
                          editable="false"
                          wrapText="true"
                          prefRowCount="5"/>

                <Label fx:id="timerLabel"
                       text="00:00"
                       style="-fx-font-size: 36px; -fx-text-fill: #FF6347;"/>

                <Label fx:id="quoteLabel"
                       text="Inspirational quote will appear here."
                       style="-fx-font-size: 16px; -fx-text-fill: #5A3E1B; -fx-padding: 20 0;"/>

                <Button fx:id="saveQuoteButton"
                        text="Save Quote"
                        onMouseClicked="#saveQuote"
                        style="-fx-font-size: 14px; -fx-padding: 8 16;"/>

                <Button text="Start Timer"
                        fx:id="startButton"
                        onMouseClicked="#startStudySession"
                        style="-fx-font-size: 16px; -fx-background-radius: 30; -fx-background-color: #FFDAB9; -fx-padding: 20 40;"/>
            </VBox>

            <!-- Right: Study Progress panel -->
            <StackPane GridPane.columnIndex="1"
                       style="-fx-background-color: white; -fx-border-color: #D3E5F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20;">
                <VBox spacing="15">
                    <Label text="Study Progress"
                           wrapText="true"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="streakLabel"
                           text="Study streak: 🔥 1"
                           wrapText="true"
                           maxWidth="200"
                           style="-fx-font-size: 14px;"/>
                    <Label fx:id="focusLabel"
                           text="Focus: 100%"
                           wrapText="true"
                           maxWidth="200"
                           style="-fx-font-size: 14px;"/>
                </VBox>
            </StackPane>
        </GridPane>
    </center>

</BorderPane>
