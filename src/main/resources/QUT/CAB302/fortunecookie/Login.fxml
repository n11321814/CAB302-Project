<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="QUT.CAB302.fortunecookie.Controller.LoginController"
            style="-fx-font-family: 'Aptos'; -fx-background-color: #FFF9F2;">

    <!-- BIG header: enlarged cookie + elegant title -->
    <top>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 30; -fx-background-color: #FFF9F2;">
            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true" pickOnBounds="true">
                <image>
                    <Image url="@QUTstudent.png"/>
                </image>
            </ImageView>
            <Text text="QUOTE ME "
                  style="
                    -fx-font-size: 40px;
                    -fx-font-style: italic;
                    -fx-font-weight: bold;
                    -fx-fill: #333333;
                  "/>
        </VBox>
    </top>

    <!-- Centered login form -->
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 30;">
            <!-- Username -->
            <VBox spacing="5" maxWidth="300">
                <Text text="Username" style="-fx-font-size: 14px;"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           style="-fx-background-radius: 5; -fx-border-radius: 5;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="5" maxWidth="300">
                <Text text="Password" style="-fx-font-size: 14px;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               style="-fx-background-radius: 5; -fx-border-radius: 5;"/>
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <Button text="Register"
                        fx:id="toRegister"
                        onAction="#goToRegister"
                        style="-fx-font-size: 14px; -fx-pref-width: 120;"/>
                <Button text="Login"
                        fx:id="toHomepage"
                        onAction="#handleLogin"
                        style="-fx-font-size: 14px; -fx-pref-width: 120;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
